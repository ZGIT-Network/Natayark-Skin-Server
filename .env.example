NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
APP_KEY=
TZ=Asia/Shanghai

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=natayark_skin
DB_USERNAME=natayark_skin
DB_PASSWORD=
# Leave empty for a new production database. Use a dev_ prefix for integration tests.
DB_TABLE_PREFIX=

PWD_METHOD=BCRYPT
SALT=
TEXTURE_DIR=storage/textures
STORAGE_DIR=storage
TRUST_PROXY=false

# Optional external login. Register the exact PUBLIC_ORIGIN callback with the provider.
NYKID_KEY=
NYKID_SECRET=
LIVE_KEY=
LIVE_SECRET=
# Minecraft Java ownership verification; callback: PUBLIC_ORIGIN/mojang/callback.
MICROSOFT_KEY=
MICROSOFT_SECRET=
OIDC_ISSUER=

# Optional SMTP. Mail verification and password recovery need a working sender.
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Natayark Skin Server"

# Optional CDN refresh; only used when the corresponding native integration is enabled.
ALICDN_SITE_BASE_URL=
ALICDN_ACCESSKEY_ID=
ALICDN_ACCESSKEY_SECRET=
