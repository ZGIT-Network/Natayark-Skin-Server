<%- include('partials/layout-standalone-top') %>

<div class="py-4 text-center">
  
  <div class="mt-4 font-display text-6xl font-semibold tracking-tighter"><%= typeof code !== 'undefined' ? code : t('error.title') %></div>
  <% if (typeof title !== 'undefined' && title) { %>
  <h1 class="mt-3 text-lg font-medium"><%= title %></h1>
  <% } %>
  <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-muted-foreground"><%= typeof message !== 'undefined' ? message : '' %></p>
  <div class="mt-6 flex flex-wrap justify-center gap-2">
    <a href="/" class="btn btn-primary"><%= typeof backLabel !== 'undefined' && backLabel ? backLabel : t('error.back-home') %></a>
    <a href="javascript:history.back()" class="btn btn-outline"><%= t('error.back-previous') %></a>
  </div>
</div>

<%- include('partials/layout-standalone-bottom') %>
