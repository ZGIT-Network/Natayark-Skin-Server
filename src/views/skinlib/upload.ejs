<%- include('../partials/layout-user-top', { title: t('skinlib.upload'), pageDescription: t('skinlib.upload-description') }) %>

<div class="grid gap-5 lg:grid-cols-3">
  <section class="card lg:col-span-2">
    <div class="card-content">
      <form id="upload-form" class="grid gap-5" data-public-storage="<%= scorePerStorage %>" data-private-storage="<%= privateScorePerStorage %>" data-closet-cost="<%= closetItemCost %>" data-upload-award="<%= award %>" data-score="<%= user.score %>">
        <label class="field">
          <span class="label"><%= t('skinlib.file') %></span>
          <span class="file-dropzone flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border border-dashed px-4 py-8 text-center transition-colors" data-file-dropzone data-max-file-size="<%= maxFileSize*1024 %>" data-drop-type-error="<%= t('upload.drop-type-error') %>" data-drop-count-error="<%= t('upload.drop-count-error') %>" data-drop-size-error="<%= t('upload.drop-size-error',{size:maxFileSize}) %>">
            <span class="text-sm font-medium"><%= t('skinlib.choose-png') %></span>
            <span id="file-name" class="text-xs text-muted-foreground"><%= t('skinlib.no-file') %></span>
            <span class="text-xs text-muted-foreground"><%= t('upload.drop-help') %></span>
            <input type="file" id="file" name="file" accept="image/png" required class="sr-only" data-file-input data-file-name="#file-name" data-file-preview="#file-preview" data-file-preview-panel="#file-preview-panel">
          </span>
          <span class="text-xs text-destructive" data-file-drop-error role="alert" hidden></span>
          <span class="field-hint"><%= t('skinlib.file-help', { size: maxFileSize }) %></span>
        </label>

        <div id="file-preview-panel" class="flex justify-center rounded-xl border border-border bg-muted/30 p-4" hidden>
          <img id="file-preview" alt="<%= t('skinlib.upload-preview') %>" class="max-h-40 w-auto" style="image-rendering: pixelated" hidden>
        </div>

        <label class="field">
          <span class="label"><%= t('skinlib.name') %></span>
          <input class="input" id="name" name="name" required maxlength="50">
        </label>

        <label class="field"><span class="label"><%= t('skinlib.description-optional') %></span><textarea class="textarea" name="description" rows="4" <%- descriptionMaxLength ? 'maxlength="' + descriptionMaxLength + '"' : '' %> placeholder="<%= t('skinlib.description-upload-placeholder') %>"></textarea></label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="field">
            <span class="label"><%= t('skinlib.type') %></span>
            <span class="select-wrap">
              <select class="select" id="type" name="type">
                <option value="skin"><%= t('skinlib.type-skin') %></option>
                <option value="cape"><%= t('skinlib.type-cape') %></option>
              </select>
            </span>
          </label>
          <label class="field">
            <span class="label"><%= t('skinlib.model') %></span>
            <span class="select-wrap">
              <select class="select" id="model" name="model">
                <option value="default"><%= t('player.model-default') %></option>
                <option value="slim"><%= t('player.model-slim') %></option>
              </select>
            </span>
            <span class="field-hint"><%= t('skinlib.slim-help') %></span>
          </label>
        </div>

        <fieldset>
          <legend class="label mb-2"><%= t('skinlib.visibility') %></legend>
          <div class="grid gap-2 sm:grid-cols-2">
            <label class="radio-row rounded-lg border border-border p-3 hover:bg-accent">
              <input type="radio" class="radio" name="public" value="1" checked>
              <span>
                <span class="block text-sm font-medium"><%= t('skinlib.public') %></span>
                <span class="block text-xs text-muted-foreground"><%= scorePerStorage %> <%= t('score.points') %> / KB · <%= t('score.upload-award') %> <%= award %> <%= t('score.points') %></span>
              </span>
            </label>
            <label class="radio-row rounded-lg border border-border p-3 hover:bg-accent">
              <input type="radio" class="radio" name="public" value="0">
              <span>
                <span class="block text-sm font-medium"><%= t('skinlib.private') %></span>
                <span class="block text-xs text-muted-foreground"><%= privateScorePerStorage %> <%= t('score.points') %> / KB · <%= t('score.upload-award') %> <%= award %> <%= t('score.points') %></span>
              </span>
            </label>
          </div>
        </fieldset>

        <p class="text-sm text-muted-foreground" id="upload-estimate" role="status" aria-live="polite" hidden></p>
        <p class="hidden text-sm text-destructive" id="upload-error" role="alert"></p>
        <button class="btn btn-primary btn-lg" type="submit"><%= t('skinlib.upload-btn') %></button>
      </form>
    </div>
  </section>

  <aside class="space-y-5">
  <% if (contentPolicyHtml) { %><section class="card"><div class="card-header"><h2 class="card-title"><%= t('skinlib.content-policy') %></h2></div><div class="card-content prose text-sm"><%- contentPolicyHtml %></div></section><% } %>
  <div class="card" data-upload-viewer>
    <%- include('../partials/previewer', { skinUrl: '', capeUrl: '', previewModel: 'default', flatSkin: '', flatCape: '' }) %>
  </div>
  <div class="card">
    <div class="card-header"><div><h2 class="card-title"><%= t('skinlib.cost-title') %></h2></div></div>
    <div class="card-content space-y-2 text-sm">
      <div class="flex items-center justify-between"><span class="text-muted-foreground"><%= t('skinlib.cost-public') %></span><span><%= scorePerStorage %> <%= t('score.points') %> / KB</span></div>
      <div class="flex items-center justify-between"><span class="text-muted-foreground"><%= t('skinlib.cost-private') %></span><span><%= privateScorePerStorage %> <%= t('score.points') %> / KB</span></div>
      <div class="flex items-center justify-between"><span class="text-muted-foreground"><%= t('skinlib.cost-award') %></span><span><%= award %> <%= t('score.points') %></span></div>
      <div class="flex items-center justify-between"><span class="text-muted-foreground"><%= t('skinlib.cost-closet') %></span><span><%= closetItemCost %> <%= t('score.points') %> <%= t('score.per-item') %></span></div>
      <p class="text-xs leading-relaxed text-muted-foreground"><%= t('skinlib.cost-note') %></p>
      <div class="border-t border-border pt-2 text-xs text-muted-foreground"><%= t('skinlib.current-score') %>：<strong class="text-foreground"><%= user.score %></strong></div>
    </div>
  </div>
  </aside>
</div>

<script src="/vendor/skinview3d.js?v=8" defer></script>
<%- include('../partials/layout-bottom') %>
