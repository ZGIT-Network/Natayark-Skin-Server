<%- include('../partials/layout-user-top', { title: texture.name, pageDescription: t('skinlib.detail-description') }) %>

<div class="grid gap-5 lg:grid-cols-2">
  <section class="card">
    <%- include('../partials/previewer', { skinUrl: texture.type === 'cape' ? '' : '/textures/' + texture.hash, capeUrl: texture.type === 'cape' ? '/textures/' + texture.hash : '', previewModel: texture.type === 'alex' ? 'slim' : 'default', flatSkin: texture.type === 'cape' ? '' : '/preview/' + texture.tid + '?v=4&png&model=' + texture.type, flatCape: texture.type === 'cape' ? '/preview/' + texture.tid + '?v=4&png' : '' }) %>
    <div class="border-t border-border px-4 py-2.5">
      <code class="block truncate text-[0.7rem] text-muted-foreground"><%= texture.hash %></code>
    </div>
  </section>

  <section class="space-y-5">
    <div class="card">
      <div class="card-header">
        <div class="min-w-0">
          <h2 class="card-title"><%= texture.name %></h2>
          <p class="card-description">
            <%= t('skinlib.uploader') %> <%= texture.nickname || ('UID ' + texture.uploader) %> · <%= texture.upload_at %>
          </p>
        </div>
        <div class="flex flex-wrap gap-1.5">
          <span class="badge badge-secondary"><%= texture.type === 'cape' ? t('skinlib.type-cape') : (texture.type === 'alex' ? 'Alex' : 'Steve') %></span>
          <% if (!texture.public) { %><span class="badge badge-warning"><%= t('skinlib.private') %></span><% } %>
          <span class="badge badge-outline"><%= t('skinlib.likes-count', { count: texture.likes }) %></span>
        </div>
      </div>
      <div class="card-content">
        <% if (user) { %>
        <div class="flex flex-wrap gap-2">
          <% if (!inCloset) { %>
          <button type="button" class="btn btn-primary" data-action="add-closet" data-tid="<%= texture.tid %>"><%- icon('star') %><%= t('skinlib.add-closet') %></button>
          <% } else { %>
          <a class="btn btn-outline" href="/user/closet"><%= t('skinlib.in-closet') %></a>
          <% } %>
          <button type="button" class="btn btn-outline" data-dialog-open="dialog-report"><%- icon('flag') %><%= t('skinlib.report') %></button>
          <% if (isOwner || isAdmin) { %>
          <button type="button" class="btn btn-outline" data-action="rename-texture" data-tid="<%= texture.tid %>" data-name="<%= texture.name %>"><%- icon('pencil') %><%= t('skinlib.rename') %></button>
          <button type="button" class="btn btn-outline" data-action="toggle-privacy" data-tid="<%= texture.tid %>" data-public="<%= texture.public ? '1' : '0' %>"><%- icon('eye') %><%= t(texture.public ? 'skinlib.set-private' : 'skinlib.set-public') %></button>
          <button type="button" class="btn btn-ghost text-destructive hover:bg-destructive/10 hover:text-destructive" data-action="delete-texture" data-tid="<%= texture.tid %>"><%- icon('trash-2') %><%= t('skinlib.delete') %></button>
          <% } %>
        </div>
        <% } %>
        <% if (allowDownload) { %><a class="btn btn-outline mt-3" href="/raw/<%= texture.tid %>" download="<%= texture.name %>.png"><%- icon('download') %><%= t('skinlib.download-texture') %></a><% } %>
        <% if ((isOwner || isAdmin) && texture.type !== 'cape') { %>
        <form data-action="texture-model" data-tid="<%= texture.tid %>" class="inline-form mt-4">
          <label class="field"><span class="label"><%= t('skinlib.model') %></span><span class="select-wrap"><select class="select" name="type"><option value="steve" <%= texture.type === 'steve' ? 'selected' : '' %>><%= t('skinlib.model-classic') %></option><option value="alex" <%= texture.type === 'alex' ? 'selected' : '' %>><%= t('skinlib.model-slim') %></option></select></span></label>
          <button type="submit" class="btn btn-outline"><%= t('skinlib.change-model') %></button>
        </form>
        <% } %>
      </div>
    </div>

    <% if (user) { %>
    <div class="card">
      <div class="card-header"><div><h2 class="card-title"><%= t('skinlib.apply') %></h2><p class="card-description"><%= t('skinlib.apply-help') %></p></div></div>
      <div class="card-content">
        <% if (applyPlayers.length === 0) { %>
        <p class="text-sm text-muted-foreground"><%= t('skinlib.no-players') %><a href="/user/player" class="font-medium text-brand-strong hover:underline dark:text-brand"><%= t('skinlib.go-create') %></a>。</p>
        <% } else { %>
        <% if (!inCloset && !isAdmin) { %>
        <p class="mb-3 text-sm text-muted-foreground"><%= t('skinlib.add-first') %></p>
        <% } %>
        <div class="flex flex-wrap gap-2">
          <% for (const p of applyPlayers) { %>
          <button type="button" class="btn btn-outline btn-sm" data-action="apply-texture" data-pid="<%= p.pid %>" data-player-name="<%= p.name %>" data-tid="<%= texture.tid %>" data-type="<%= texture.type === 'cape' ? 'cape' : 'skin' %>" <%= p.applied || (!inCloset && !isAdmin) ? 'disabled' : '' %>><%- icon('shirt') %><%= p.name %><%= p.applied ? ' · ' + t('skinlib.applied') : '' %></button>
          <% } %>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <div class="card">
      <div class="card-header"><div><h2 class="card-title"><%= t('skinlib.description') %></h2></div></div>
      <div class="card-content">
        <div id="texture-description" class="prose text-sm leading-relaxed"><%- descriptionHtml || '<p class="text-muted-foreground">' + t('skinlib.no-description') + '</p>' %></div>
        <% if (isOwner || isAdmin) { %>
        <form data-action="save-description" data-tid="<%= texture.tid %>" class="mt-4 space-y-3">
          <label class="field"><span class="label"><%= t('skinlib.edit-description') %></span><textarea class="textarea" name="description" rows="6" <%- descriptionMaxLength ? 'maxlength="' + descriptionMaxLength + '"' : '' %> placeholder="<%= t('skinlib.description-placeholder') %>"><%= description %></textarea><span class="field-hint"><%= descriptionMaxLength ? t('skinlib.description-limit', { count: descriptionMaxLength }) : t('skinlib.description-bytes') %></span></label>
          <button class="btn btn-outline btn-sm" type="submit"><%- icon('check') %><%= t('skinlib.save-description') %></button>
        </form>
        <% } %>
      </div>
    </div>
  </section>
</div>

<% if (user) { %>
<dialog class="dialog" id="dialog-report">
  <div class="dialog-header">
    <h2 class="dialog-title"><%= t('skinlib.report-title') %></h2>
    <p class="dialog-description"><%= t('skinlib.report-help') %></p>
    <button type="button" class="btn btn-ghost btn-icon btn-sm dialog-close" data-dialog-close aria-label="<%= t('common.close') %>"><%- icon('x') %></button>
  </div>
  <form data-action="submit-report" data-tid="<%= texture.tid %>">
    <div class="dialog-body">
      <label class="field">
        <span class="label"><%= t('skinlib.reason') %></span>
        <textarea class="textarea" name="reason" rows="4" required maxlength="1000" placeholder="<%= t('skinlib.reason-placeholder') %>"></textarea>
      </label>
      <p class="mt-2 hidden text-sm text-destructive" data-form-error></p>
    </div>
    <div class="dialog-footer">
      <button type="button" class="btn btn-outline" data-dialog-close><%= t('common.cancel') %></button>
      <button class="btn btn-destructive" type="submit"><%= t('skinlib.report') %></button>
    </div>
  </form>
</dialog>
<% } %>

<script src="/vendor/skinview3d.js?v=8" defer></script>
<%- include('../partials/layout-bottom') %>
