<%- include('../partials/layout-user-top', { title: '我的举报', pageDescription: '追踪已提交的材质举报与处理结果。' }) %>
<section class="card"><div class="card-header"><div><h2 class="card-title">举报记录</h2><p class="card-description">共 <%= total %> 条记录</p></div><a href="/skinlib" class="btn btn-outline btn-sm">浏览皮肤库</a></div>
  <% if (!rows.length) { %><div class="empty-state"><div class="empty-state-title">暂无举报记录</div><p class="empty-state-text">遇到侵权或违规材质，可以在详情页提交举报。</p></div><% } %>
  <div class="report-list"><% for (const row of rows) { %><article class="report-record"><div class="record-heading"><div><a class="font-medium hover:underline" href="/skinlib/show/<%= row.tid %>"><%= row.texture_name || '已删除的材质' %> <span class="text-muted-foreground text-xs">#<%= row.tid %></span></a><p class="text-xs text-muted-foreground mt-1">举报 #<%= row.id %> · <%= row.report_at %></p></div><span class="badge <%= row.status === 0 ? 'badge-warning' : row.status === 1 ? 'badge-success' : 'badge-outline' %>"><%= ['待处理','已采纳','已驳回'][row.status] || '已处理' %></span></div><p class="report-reason"><%= row.reason %></p></article><% } %></div>
</section>
<%- include('../partials/pagination',{path:'/user/reports',query:{}}) %>
<%- include('../partials/layout-bottom') %>
