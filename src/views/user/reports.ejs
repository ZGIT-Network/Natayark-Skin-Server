<%- include('../partials/layout-user-top', { title: t('reports.title'), pageDescription: t('reports.description') }) %>
<section class="card"><div class="card-header"><div><h2 class="card-title"><%= t('reports.records') %></h2><p class="card-description"><%= t('common.count-records', { count: total }) %></p></div><a href="/skinlib" class="btn btn-outline btn-sm"><%= t('reports.browse') %></a></div>
  <% if (!rows.length) { %><div class="empty-state"><div class="empty-state-title"><%= t('reports.none') %></div><p class="empty-state-text"><%= t('reports.none-help') %></p></div><% } %>
  <div class="report-list"><% for (const row of rows) { %><article class="report-record"><div class="record-heading"><div><a class="font-medium hover:underline" href="/skinlib/show/<%= row.tid %>"><%= row.texture_name || t('reports.deleted-texture') %> <span class="text-muted-foreground text-xs">#<%= row.tid %></span></a><p class="text-xs text-muted-foreground mt-1"><%= t('reports.report') %> #<%= row.id %> · <%= row.report_at %></p></div><span class="badge <%= row.status === 0 ? 'badge-warning' : row.status === 1 ? 'badge-success' : 'badge-outline' %>"><%= t(['reports.pending','reports.accepted','reports.rejected'][row.status] || 'reports.handled') %></span></div><p class="report-reason"><%= row.reason %></p></article><% } %></div>
</section>
<%- include('../partials/layout-bottom') %>
