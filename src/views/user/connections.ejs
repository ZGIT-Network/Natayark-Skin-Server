<%- include('../partials/layout-user-top', { title: t('general.connections'), pageDescription: t('connections.page-description') }) %>

<div class="grid gap-5 lg:grid-cols-3">
  <section class="card lg:col-span-2">
    <div class="card-header">
      <div>
        <h2 class="card-title"><%= t('connections.third-party') %></h2>
        <p class="card-description"><%= t('connections.third-party-help') %></p>
      </div>
    </div>
    <div class="card-content">
      <% if (identities.length === 0 && providers.length === 0) { %>
      <div class="empty-state">

        <div class="empty-state-title"><%= t('connections.none') %></div>
      </div>
      <% } %>

      <% if (identities.length > 0) { %>
      <ul class="divide-y divide-border">
        <% for (const identity of identities) { %>
        <li class="flex flex-wrap items-center justify-between gap-3 py-3 first:pt-0 last:pb-0">
          <div class="min-w-0 flex items-center gap-3 wrap-anywhere">
            <div>
              <div class="text-sm font-medium"><%= providers.find(p => p.key === identity.provider)?.displayName || identity.provider %></div>
              <div class="text-xs text-muted-foreground"><%= identity.display_name || t('connections.bound') %></div>
            </div>
          </div>
          <form method="post" action="/user/connections/<%= encodeURIComponent(identity.provider) %>/unlink" data-action="unlink-identity">
            <input type="hidden" name="csrf" value="<%= csrf %>">
            <button type="submit" class="btn btn-outline btn-sm text-destructive" <%= identity.canUnlink ? '' : 'disabled' %>><%= t(identity.canUnlink ? 'connections.unlink' : 'connections.keep') %></button>
          </form>
        </li>
        <% } %>
      </ul>
      <% } %>

      <% const unbound = providers.filter(p => !identities.some(i => i.provider === p.key)); %>
      <% if (unbound.length > 0) { %>
      <div class="mt-4 flex flex-wrap gap-2 border-t border-border pt-4">
        <% for (const provider of unbound) { %>
        <form method="post" action="/user/connections/<%= encodeURIComponent(provider.key) %>/link" class="min-w-0 max-w-full">
          <input type="hidden" name="csrf" value="<%= csrf %>">
          <button class="btn btn-outline btn-sm btn-wrap max-w-full" type="submit"><%= t('connections.link', { provider: provider.displayName }) %></button>
        </form>
        <% } %>
      </div>
      <% } %>

      <% if (!localLoginEnabled) { %>
      <p class="mt-4 text-xs text-muted-foreground"><%= t('connections.local-off') %></p>
      <% } else if (!hasPassword) { %>
      <p class="mt-4 text-xs text-muted-foreground"><%= t('connections.set-password-first') %><a href="/auth/oauth/set-password" class="font-medium text-brand-strong hover:underline dark:text-brand"><%= t('connections.set-password-link') %></a><%= t('connections.set-password-suffix') %></p>
      <% } %>
    </div>
  </section>

  <aside class="space-y-5">
    <section class="card">
      <div class="card-header"><div><h2 class="card-title"><%= t('connections.mojang') %></h2></div></div>
      <div class="card-content">
        <p class="text-sm text-muted-foreground"><%= t('connections.mojang-help') %></p>
        <a href="/user/verification" class="btn btn-outline btn-sm mt-3 w-full"><%= t('connections.go-verify') %></a>
      </div>
    </section>
  </aside>
</div>

<div class="mt-5">
  <div class="mb-3 flex items-center justify-between gap-3">
    <h2 class="text-base font-semibold"><%= t('connections.authorized-apps') %></h2>
  </div>
  <% if (grants.length === 0) { %>
  <div class="card">
    <div class="empty-state">

      <div class="empty-state-title"><%= t('connections.no-apps') %></div>
      <div class="empty-state-text"><%= t('connections.no-apps-help') %></div>
    </div>
  </div>
  <% } else { %>
  <div class="card overflow-hidden">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th><%= t('connections.app') %></th><th><%= t('connections.scopes') %></th><th><%= t('connections.authorized-at') %></th><th class="text-right"><%= t('connections.actions') %></th></tr>
        </thead>
        <tbody>
          <% for (const g of grants) { %>
          <tr>
            <td class="font-medium"><%= g.client?.name ?? (t('common.client') + ' #' + g.client?.id) %></td>
            <td><code class="text-xs text-muted-foreground"><%= (g.scopes || []).join(' ') %></code></td>
            <td class="text-muted-foreground"><%= g.grantedAt ? new Date(g.grantedAt * 1000).toLocaleString(locale === 'en' ? 'en' : 'zh-CN') : '—' %></td>
            <td class="text-right">
              <form method="post" action="/connect/grants/revoke" data-confirm="<%= t('connections.revoke-confirm') %>" data-confirm-danger>
                <input type="hidden" name="csrf" value="<%= csrf %>">
                <input type="hidden" name="client_id" value="<%= g.client?.id %>">
                <button class="btn btn-ghost btn-sm text-destructive hover:bg-destructive/10 hover:text-destructive" type="submit"><%= t('connections.revoke') %></button>
              </form>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>
</div>

<%- include('../partials/layout-bottom') %>
