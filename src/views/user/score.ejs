<%- include('../partials/layout-user-top', { title: t('score.rules-title'), pageDescription: t('score.rules-description') }) %>
<div class="score-summary"><div><span class="text-sm text-muted-foreground"><%= t('score.balance') %></span><strong><%= user.score %><small><%= t('score.points') %></small></strong></div><a href="/user" class="btn btn-outline btn-sm"><%= t('score.back') %></a></div>
<div class="grid gap-5 lg:grid-cols-2"><section class="card"><div class="card-header"><h2 class="card-title"><%= t('score.spend') %></h2></div><dl class="rule-list">
  <% for (const [labelKey,key,unitKey] of [['score.new-player','score_per_player','score.per-item'],['score.public-storage','score_per_storage','score.per-kb'],['score.private-storage','private_score_per_storage','score.per-kb'],['score.closet','score_per_closet_item','score.per-item']]) { %><div><dt><%= t(labelKey) %></dt><dd><strong><%= rules[key] %></strong> <span><%= t(unitKey) %></span></dd></div><% } %>
</dl><p class="rule-note"><%= t('score.note') %></p></section>
<section class="card"><div class="card-header"><h2 class="card-title"><%= t('score.earn') %></h2></div><dl class="rule-list">
  <% for (const [labelKey,key,unitKey] of [['score.upload-award','score_award_per_texture','score.per-item'],['score.like-award','score_award_per_like','score.per-like'],['score.report-award','reporter_reward_score','score.per-like']]) { %><div><dt><%= t(labelKey) %></dt><dd><strong><%= rules[key] %></strong> <span><%= t(unitKey) %></span></dd></div><% } %>
  <div><dt><%= t('score.sign-award') %></dt><dd><strong><%= rules.sign_score.replace(',', ' – ') %></strong></dd></div><div><dt><%= t('score.return-award') %></dt><dd><%= t(['true','1'].includes(rules.return_score) ? 'common.enabled' : 'common.disabled') %></dd></div>
</dl><p class="rule-note"><%= t('score.sign-note', { reset: ['true','1'].includes(rules.sign_after_zero) ? t('score.sign-reset-zero') : t('score.sign-reset-gap', { hours: rules.sign_gap_time }), change: (Number(rules.reporter_score_modification) > 0 ? '+' : '') + rules.reporter_score_modification }) %></p></section></div>
<%- include('../partials/layout-bottom') %>
