<%- include('../partials/layout-user-top', { title: t('general.my-closet'), pageDescription: t('closet.page-description') }) %>
<div class="closet-toolbar"><form class="library-search" method="get"><select class="select" name="type" aria-label="<%= t('skinlib.type-label') %>"><% for (const [key,label] of [['',t('common.all-types')],['skin',t('skinlib.type-skin')],['cape',t('skinlib.type-cape')],['steve','Steve'],['alex','Alex']]) { %><option value="<%= key %>" <%= type === key ? 'selected' : '' %>><%= label %></option><% } %></select><input class="input" name="q" value="<%= keyword %>" placeholder="<%= t('closet.search-placeholder') %>" aria-label="<%= t('closet.search-placeholder') %>"><button class="btn btn-primary btn-icon" aria-label="<%= t('common.search') %>"><%- icon('search') %></button></form><a href="/skinlib" class="btn btn-outline btn-sm"><%- icon('plus') %><%= t('closet.add') %></a></div>
<p class="text-sm text-muted-foreground mb-4"><%= t('common.count-items', { count: total }) %></p>
<%- include('../partials/closet-grid',{manageUid:0}) %>
<%- include('../partials/pagination',{path:'/user/closet',query:{q:keyword,type}}) %>
<%- include('../partials/layout-bottom') %>
