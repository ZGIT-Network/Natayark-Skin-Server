<%- include('../partials/layout-user-top', { title: t('general.my-closet'), pageDescription: '收藏并整理喜欢的材质，在角色管理中应用。' }) %>
<div class="closet-toolbar"><form class="library-search" method="get"><select class="select" name="type" aria-label="材质类型"><% for (const [key,label] of [['','全部类型'],['skin','皮肤'],['cape','披风'],['steve','Steve'],['alex','Alex']]) { %><option value="<%= key %>" <%= type === key ? 'selected' : '' %>><%= label %></option><% } %></select><input class="input" name="q" value="<%= keyword %>" placeholder="搜索衣柜名称" aria-label="搜索衣柜"><button class="btn btn-primary btn-icon" aria-label="搜索"><%- icon('search') %></button></form><a href="/skinlib" class="btn btn-outline btn-sm"><%- icon('plus') %>添加材质</a></div>
<p class="text-sm text-muted-foreground mb-4">共 <%= total %> 件材质</p>
<%- include('../partials/closet-grid',{manageUid:0}) %>
<%- include('../partials/pagination',{path:'/user/closet',query:{q:keyword,type}}) %>
<%- include('../partials/layout-bottom') %>
