<%- include('../partials/layout-user-top', { title: t('general.verification'), pageDescription: '通过 Microsoft 登录确认 Minecraft Java 版所有权。' }) %>

<% if (error) { %>
<div class="alert alert-destructive mb-5" role="alert">
  <%- icon('alert-triangle') %>
  <div><%= error %></div>
</div>
<% } %>
<% if (completed) { %>
<div class="alert alert-success mb-5" role="status" data-feedback-message="正版验证已完成。">
  <%- icon('circle-check') %>
  <div>正版验证已完成。</div>
</div>
<% } %>

<% if (verification?.verified) { %>
<section class="card">
  <div class="card-header">
    <div>
      <h2 class="card-title">已验证</h2>
      <p class="card-description">此账户已关联 Minecraft Java 版账户。感谢您对正版游戏的支持。</p>
    </div>
    <span class="badge badge-success"><%- icon('badge-check') %>JAVA EDITION</span>
  </div>
  <div class="card-content">
    <dl class="grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs font-medium text-muted-foreground">正版 UUID</dt>
        <dd class="mt-1 text-sm"><%- include('../partials/private-uuid', {uuidValue:verification.uuid,uuidUrl:'/user/privacy/uuid?source=mojang'}) %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-muted-foreground">本地角色</dt>
        <dd class="mt-1 text-sm"><%= mappings.map(p => p.name).join('、') || '当前尚无使用此 UUID 的角色' %></dd>
      </div>
    </dl>
    <% if (mappings.length === 0) { %>
    <div class="mt-5 rounded-lg border border-border p-4">
      <p class="text-sm text-muted-foreground">原角色的 UUID 已保留。若要使用正版 UUID，请确认角色名称与正版一致后同步。</p>
      <form method="post" action="/mojang/update-uuid" class="mt-3">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <button type="submit" class="btn btn-outline btn-sm">同步正版 UUID</button>
      </form>
    </div>
    <% } %>
  </div>
</section>
<% } else { %>
<div class="grid gap-5 lg:grid-cols-3">
  <section class="card lg:col-span-2">
    <div class="card-header"><div><h2 class="card-title">绑定 Java 版账户</h2><p class="card-description">验证后，正版角色会关联到当前皮肤站账户。</p></div></div>
    <div class="card-content">
      <% if (reward > 0) { %>
      <div class="alert alert-info mb-4">
        <%- icon('gift') %>
        <div>首次完成验证可获得 <strong><%= reward %></strong> 积分。</div>
      </div>
      <% } %>
      <% if (configured) { %>
      <form method="post" action="/mojang/verify">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <button type="submit" class="btn btn-primary">使用 Microsoft 验证</button>
      </form>
      <% } else { %>
      <p class="text-sm text-muted-foreground"><%= configurationProblem %></p>
      <% } %>
    </div>
  </section>
  <aside class="card">
    <div class="card-header"><div><h2 class="card-title">说明</h2></div></div>
    <div class="card-content text-sm leading-relaxed text-muted-foreground">
      验证使用 Microsoft OAuth，仅用于确认 Minecraft Java 版所有权。站点不会获取你的 Microsoft 密码。
    </div>
  </aside>
</div>
<% } %>

<a href="/user/connections" class="btn btn-ghost btn-sm mt-5">返回登录方式</a>

<%- include('../partials/layout-bottom') %>
