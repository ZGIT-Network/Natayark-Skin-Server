<%- include('../partials/layout-user-top', { title: t('general.verification'), pageDescription: t('verification.page-description') }) %>

<% if (error) { %>
<div class="alert alert-destructive mb-5" role="alert">
  <%- icon('alert-triangle') %>
  <div><%= error %></div>
</div>
<% } %>
<% if (completed) { %>
<div class="alert alert-success mb-5" role="status" data-feedback-message="<%= t('verification.done') %>">
  <%- icon('circle-check') %>
  <div><%= t('verification.done') %></div>
</div>
<% } %>

<% if (verification?.verified) { %>
<section class="card">
  <div class="card-header">
    <div>
      <h2 class="card-title"><%= t('verification.verified') %></h2>
      <p class="card-description"><%= t('verification.linked-help') %></p>
    </div>
    <span class="badge badge-success"><%- icon('badge-check') %>JAVA EDITION</span>
  </div>
  <div class="card-content">
    <dl class="grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-xs font-medium text-muted-foreground"><%= t('verification.uuid') %></dt>
        <dd class="mt-1 text-sm"><%- include('../partials/private-uuid', {uuidValue:verification.uuid,uuidUrl:'/user/privacy/uuid?source=mojang'}) %></dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-muted-foreground"><%= t('verification.local-players') %></dt>
        <dd class="mt-1 text-sm"><%= mappings.map(p => p.name).join(locale === 'en' ? ', ' : '、') || t('verification.no-mapping') %></dd>
      </div>
    </dl>
    <% if (mappings.length === 0) { %>
    <% const syncLabel=t(singlePlayerSync ? 'verification.sync-player' : 'verification.sync'); %>
    <div class="mt-5 rounded-lg border border-border p-4">
      <p class="text-sm text-muted-foreground"><%= t(singlePlayerSync ? 'verification.single-player-kept' : 'verification.uuid-kept') %></p>
      <form method="post" action="/mojang/update-uuid" class="mt-3" data-confirm="<%= t(singlePlayerSync ? 'verification.single-player-sync-confirm' : 'verification.uuid-sync-confirm') %>" data-confirm-title="<%= syncLabel %>" data-confirm-text="<%= syncLabel %>" data-cancel-text="<%= t('auth.cancel') %>">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <button type="submit" class="btn btn-outline btn-sm"><%= syncLabel %></button>
      </form>
    </div>
    <% } %>
  </div>
</section>
<% } else { %>
<div class="grid gap-5 lg:grid-cols-3">
  <section class="card lg:col-span-2">
    <div class="card-header"><div><h2 class="card-title"><%= t('verification.bind') %></h2><p class="card-description"><%= t('verification.bind-help') %></p></div></div>
    <div class="card-content">
      <% if (reward > 0) { %>
      <div class="alert alert-info mb-4">
        <%- icon('gift') %>
        <div><%= t('verification.reward', { score: reward }) %></div>
      </div>
      <% } %>
      <% if (configured) { %>
      <form method="post" action="/mojang/verify">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <button type="submit" class="btn btn-primary"><%= t('verification.start') %></button>
      </form>
      <% } else { %>
      <p class="text-sm text-muted-foreground"><%= configurationProblem %></p>
      <% } %>
    </div>
  </section>
  <aside class="card">
    <div class="card-header"><div><h2 class="card-title"><%= t('verification.notes') %></h2></div></div>
    <div class="card-content text-sm leading-relaxed text-muted-foreground">
      <%= t('verification.notes-help') %>
    </div>
  </aside>
</div>
<% } %>

<a href="/user/connections" class="btn btn-ghost btn-sm mt-5"><%= t('verification.back') %></a>

<%- include('../partials/layout-bottom') %>
