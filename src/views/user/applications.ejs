<%- include('../partials/layout-user-top', { title: t('general.oauth-manage'), pageDescription: t('applications.page-description') }) %>

<div class="grid gap-5 lg:grid-cols-3">
  <section class="card lg:col-span-2">
    <div class="card-header">
      <div>
        <h2 class="card-title"><%= t('applications.my-apps') %></h2>
        <p class="card-description"><%= t('applications.count', { count: clients.length }) %></p>
      </div>
    </div>
    <% if (clients.length === 0) { %>
    <div class="empty-state">

      <div class="empty-state-title"><%= t('applications.none') %></div>
      <div class="empty-state-text"><%= t('applications.none-help') %></div>
    </div>
    <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th><%= t('applications.name-id') %></th><th><%= t('applications.secret') %></th><th><%= t('applications.redirect') %></th><th class="text-right"><%= t('common.actions') %></th></tr>
        </thead>
        <tbody>
          <% for (const client of clients) { %>
          <tr>
            <td>
              <div class="font-medium"><%= client.name %></div>
              <div class="mt-0.5 font-mono text-[0.7rem] text-muted-foreground"><%= client.id %></div>
            </td>
            <td>
              <% if (client.secret) { %>
              <details class="group">
                <summary class="cursor-pointer text-xs font-medium text-brand-strong hover:underline dark:text-brand"><%= t('applications.show-secret') %></summary>
                <div class="mt-1 flex items-center gap-1">
                  <code class="max-w-40 truncate text-[0.7rem] text-muted-foreground"><%= client.secret %></code>
                  <button type="button" class="btn btn-ghost btn-icon btn-xs" data-copy-text="<%= client.secret %>" aria-label="<%= t('applications.copy-secret') %>"><%- icon('copy') %></button>
                </div>
              </details>
              <% } else { %>
              <span class="badge badge-outline"><%= t('applications.public-client') %></span>
              <% } %>
            </td>
            <td><code class="text-xs text-muted-foreground"><%= client.redirect || '—' %></code></td>
            <td class="text-right">
              <button type="button" class="btn btn-ghost btn-sm text-destructive hover:bg-destructive/10 hover:text-destructive" data-revoke-client="<%= client.id %>"><%= t('applications.revoke') %></button>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>

  <section class="card">
    <div class="card-header"><div><h2 class="card-title"><%= t('applications.create') %></h2></div></div>
    <div class="card-content">
      <form id="create-client" class="grid gap-4">
        <label class="field">
          <span class="label"><%= t('applications.app-name') %></span>
          <input class="input" name="name" required maxlength="100">
        </label>
        <label class="field">
          <span class="label"><%= t('applications.redirect') %></span>
          <textarea class="textarea" name="redirect" required rows="3" placeholder="https://example.com/callback"></textarea>
          <span class="field-hint"><%= t('applications.redirect-help') %></span>
        </label>
        <label class="checkbox-row">
          <input type="checkbox" class="checkbox" id="public_client" name="public_client" value="1">
          <span><%= t('applications.public-client-label') %></span>
        </label>
        <button class="btn btn-primary" type="submit"><%= t('applications.register') %></button>
        <p id="client-message" class="text-sm text-destructive" role="status"></p>
      </form>
    </div>
  </section>
</div>

<section class="card mt-5"><div class="card-header"><div><h2 class="card-title"><%= t('applications.personal-tokens') %></h2><p class="card-description"><%= t('applications.personal-tokens-help') %></p></div></div><form class="card-content space-y-4" id="create-personal-token"><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"><% for (const scope of availableScopes) { %><label class="checkbox-row"><input class="checkbox" type="checkbox" name="scopes" value="<%= scope.id %>"><span><%= scope.description %></span></label><% } %></div><button class="btn btn-outline" type="submit"><%- icon('key-round') %><%= t('applications.create-token') %></button><div class="space-y-2" data-token-result hidden><label class="field"><span class="label"><%= t('applications.new-token') %></span><textarea class="textarea font-mono text-xs" rows="4" readonly data-new-token></textarea><span class="field-hint"><%= t('applications.token-help') %></span></label><button type="button" class="btn btn-outline btn-sm" data-copy-new-token><%- icon('copy') %><%= t('applications.copy-token') %></button></div></form></section>
<% if (tokens && tokens.length) { %>
<div class="mt-5">
  <div class="mb-3 flex items-center justify-between gap-3">
    <h2 class="text-base font-semibold"><%= t('applications.personal-tokens') %></h2>
  </div>
  <div class="card overflow-hidden">
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th><%= t('applications.identifier') %></th><th><%= t('common.scopes') %></th><th><%= t('applications.created-at') %></th><th><%= t('applications.expires-at') %></th><th><%= t('common.actions') %></th></tr></thead>
        <tbody>
          <% for (const token of tokens) { %>
          <tr>
            <td><code class="text-xs"><%= token.id.slice(0,12) %>…</code></td>
            <td><code class="text-xs text-muted-foreground"><%= (token.scopes || []).join(' ') %></code></td>
            <td class="text-muted-foreground"><%= token.created_at %></td>
            <td class="text-muted-foreground"><%= token.expires_at || '—' %></td>
            <td><button class="btn btn-outline btn-xs" data-revoke-token="<%= token.id %>"><%= t('connections.revoke') %></button></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% } %>

<script src="/js/applications.js?v=8" defer></script>
<%- include('../partials/layout-bottom') %>
