<%- include('../partials/layout-user-top', { title: t('general.profile'), pageDescription: '管理昵称、邮箱、密码与偏好设置。' }) %>

<% if (!user.verified) { %>
<div class="alert alert-warning mb-5">
  <%- icon('mail') %>
  <div class="flex-1">
    <div class="alert-title"><%= t('profile.email-unverified') %></div>
    <p class="alert-description"><%= t('profile.email-unverified-help') %></p>
  </div>
  <form method="post" action="/auth/verify-email/send">
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <button class="btn btn-outline btn-sm" type="submit"><%= t('common.send-verification') %></button>
  </form>
</div>
<% } %>

<% if (error) { %>
<div class="alert alert-destructive mb-5" role="alert">
  <%- icon('alert-triangle') %>
  <div><%= error %></div>
</div>
<% } %>

<div class="grid gap-5 lg:grid-cols-2">
  <section class="card">
    <div class="card-header"><div><h2 class="card-title"><%= t('profile.avatar') %></h2><p class="card-description"><%= t('profile.avatar-description') %></p></div></div>
    <div class="card-content">
      <div class="flex items-center gap-4">
        <span class="avatar size-16 rounded-xl border border-border">
          <img src="/avatar/user/<%= user.uid %>?v=5&size=96" alt="" width="96" height="96">
        </span>
        <form method="post" action="/user/profile" class="flex-1">
          <input type="hidden" name="csrf" value="<%= csrf %>">
          <input type="hidden" name="action" value="avatar">
          <div class="flex gap-1.5">
            <input class="input" type="number" id="avatar" name="avatar" min="0" value="<%= user.avatar ?? 0 %>" aria-label="<%= t('profile.avatar-tid') %>">
            <button class="btn btn-outline" type="submit"><%= t('common.update') %></button>
          </div>
          <p class="field-hint"><%= t('profile.avatar-help') %></p>
        </form>
      </div>
    </div>
  </section>

  <section class="card">
    <div class="card-header"><div><h2 class="card-title"><%= t('profile.nickname') %></h2></div></div>
    <div class="card-content">
      <form method="post" action="/user/profile" class="flex gap-1.5">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <input type="hidden" name="action" value="nickname">
        <input class="input" name="nickname" value="<%= user.nickname %>" maxlength="50" required aria-label="<%= t('profile.nickname') %>">
        <button class="btn btn-outline" type="submit"><%= t('common.save') %></button>
      </form>
    </div>
  </section>

  <section class="card">
    <div class="card-header"><div><h2 class="card-title"><%= t('profile.email') %></h2><p class="card-description"><%= t('profile.email-change-help') %></p></div></div>
    <div class="card-content">
      <form method="post" action="/user/profile" class="grid gap-3">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <input type="hidden" name="action" value="email">
        <input class="input" type="email" name="email" value="<%= user.email %>" required aria-label="<%= t('profile.email') %>">
        <% if (hasPassword) { %>
        <input class="input" type="password" name="current_password" placeholder="<%= t('profile.current-password') %>" autocomplete="current-password" required>
        <% } %>
        <div class="flex justify-end"><button class="btn btn-outline" type="submit"><%= t('common.send-verification') %></button></div>
      </form>
    </div>
  </section>

  <section class="card">
    <div class="card-header"><div><h2 class="card-title"><%= t(hasPassword ? 'profile.change-password' : 'profile.set-password') %></h2><p class="card-description"><%= t('profile.password-description') %></p></div></div>
    <div class="card-content">
      <form method="post" action="/user/profile" class="grid gap-3">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <input type="hidden" name="action" value="password">
        <% if (hasPassword) { %>
        <input class="input" type="password" name="current_password" placeholder="<%= t('profile.current-password') %>" required autocomplete="current-password">
        <% } %>
        <input class="input" type="password" name="password" placeholder="<%= t('profile.new-password') %>" required minlength="8" autocomplete="new-password">
        <div class="flex justify-end"><button class="btn btn-outline" type="submit"><%= t('common.save') %></button></div>
      </form>
    </div>
  </section>

  <section class="card lg:col-span-2">
    <div class="card-header"><div><h2 class="card-title"><%= t('profile.preferences') %></h2></div></div>
    <div class="card-content">
      <label class="field max-w-xs mb-5">
        <span class="label"><%= t('theme.choose') %></span>
        <span class="select-wrap"><select class="select" data-theme-select><option value="system"><%= t('theme.system') %></option><option value="light"><%= t('theme.light') %></option><option value="dark"><%= t('theme.dark') %></option></select></span>
        <span class="field-hint"><%= t('profile.theme-saved') %></span>
      </label>
      <form method="post" action="/user/profile" class="flex flex-wrap items-end gap-3">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <input type="hidden" name="action" value="locale">
        <label class="field max-w-xs flex-1">
          <span class="label"><%= t('profile.language') %></span>
          <span class="select-wrap">
            <select class="select" id="locale" name="locale">
              <option value="zh_CN" <%= locale === 'en' ? '' : 'selected' %>>简体中文</option>
              <option value="en" <%= locale === 'en' ? 'selected' : '' %>>English</option>
            </select>
          </span>
        </label>
        <button class="btn btn-outline" type="submit"><%= t('common.save') %></button>
      </form>
    </div>
  </section>
</div>

<%- include('../partials/layout-bottom') %>
