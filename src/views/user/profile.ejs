<%- include('../partials/layout-user-top', { title: t('general.profile'), pageDescription: '管理昵称、邮箱、密码与偏好设置。' }) %>

<% if (!user.verified) { %>
<div class="alert alert-warning mb-5">
  <%- icon('mail') %>
  <div class="flex-1">
    <div class="alert-title">邮箱尚未验证</div>
    <p class="alert-description">请检查邮箱或重新发送验证邮件。</p>
  </div>
  <form method="post" action="/auth/verify-email/send">
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <button class="btn btn-outline btn-sm" type="submit">发送验证邮件</button>
  </form>
</div>
<% } %>

<% if (error) { %>
<div class="alert alert-destructive mb-5" role="alert">
  <%- icon('alert-triangle') %>
  <div><%= error %></div>
</div>
<% } %>

<div class="grid gap-5 lg:grid-cols-2">
  <section class="card">
    <div class="card-header"><div><h2 class="card-title">头像</h2><p class="card-description">使用衣柜中的皮肤作为头像。</p></div></div>
    <div class="card-content">
      <div class="flex items-center gap-4">
        <span class="avatar size-16 rounded-xl border border-border">
          <img src="/avatar/user/<%= user.uid %>?size=96" alt="">
        </span>
        <form method="post" action="/user/profile" class="flex-1">
          <input type="hidden" name="csrf" value="<%= csrf %>">
          <input type="hidden" name="action" value="avatar">
          <div class="flex gap-1.5">
            <input class="input" type="number" id="avatar" name="avatar" min="0" value="<%= user.avatar ?? 0 %>" aria-label="头像材质 TID">
            <button class="btn btn-outline" type="submit">更新</button>
          </div>
          <p class="field-hint">填入衣柜中皮肤材质的 TID，0 表示默认头像。</p>
        </form>
      </div>
    </div>
  </section>

  <section class="card">
    <div class="card-header"><div><h2 class="card-title">昵称</h2></div></div>
    <div class="card-content">
      <form method="post" action="/user/profile" class="flex gap-1.5">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <input type="hidden" name="action" value="nickname">
        <input class="input" name="nickname" value="<%= user.nickname %>" maxlength="50" required aria-label="昵称">
        <button class="btn btn-outline" type="submit">保存</button>
      </form>
    </div>
  </section>

  <section class="card">
    <div class="card-header"><div><h2 class="card-title">邮箱</h2><p class="card-description">修改后需要验证新邮箱才会生效。</p></div></div>
    <div class="card-content">
      <form method="post" action="/user/profile" class="grid gap-3">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <input type="hidden" name="action" value="email">
        <input class="input" type="email" name="email" value="<%= user.email %>" required aria-label="邮箱">
        <% if (hasPassword) { %>
        <input class="input" type="password" name="current_password" placeholder="当前密码" autocomplete="current-password" required>
        <% } %>
        <div class="flex justify-end"><button class="btn btn-outline" type="submit">发送验证邮件</button></div>
      </form>
    </div>
  </section>

  <section class="card">
    <div class="card-header"><div><h2 class="card-title"><%= hasPassword ? '修改密码' : '设置密码' %></h2><p class="card-description">密码用于启动器与 Yggdrasil 登录。</p></div></div>
    <div class="card-content">
      <form method="post" action="/user/profile" class="grid gap-3">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <input type="hidden" name="action" value="password">
        <% if (hasPassword) { %>
        <input class="input" type="password" name="current_password" placeholder="当前密码" required autocomplete="current-password">
        <% } %>
        <input class="input" type="password" name="password" placeholder="新密码（至少 8 位）" required minlength="8" autocomplete="new-password">
        <div class="flex justify-end"><button class="btn btn-outline" type="submit">保存</button></div>
      </form>
    </div>
  </section>

  <section class="card lg:col-span-2">
    <div class="card-header"><div><h2 class="card-title">偏好</h2></div></div>
    <div class="card-content">
      <label class="field max-w-xs mb-5">
        <span class="label"><%= t('theme.choose') %></span>
        <span class="select-wrap"><select class="select" data-theme-select><option value="system"><%= t('theme.system') %></option><option value="light"><%= t('theme.light') %></option><option value="dark"><%= t('theme.dark') %></option></select></span>
        <span class="field-hint">保存在当前浏览器；跟随系统时会自动切换。</span>
      </label>
      <form method="post" action="/user/profile" class="flex flex-wrap items-end gap-3">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <input type="hidden" name="action" value="locale">
        <label class="field max-w-xs flex-1">
          <span class="label">界面语言</span>
          <span class="select-wrap">
            <select class="select" id="locale" name="locale">
              <option value="zh_CN" <%= user.locale === 'en' ? '' : 'selected' %>>简体中文</option>
              <option value="en" <%= user.locale === 'en' ? 'selected' : '' %>>English</option>
            </select>
          </span>
        </label>
        <button class="btn btn-outline" type="submit">保存</button>
      </form>
    </div>
  </section>
</div>

<%- include('../partials/layout-bottom') %>
