<%- include('../partials/layout-user-top', { title: t('general.notifications'), pageDescription: t('notifications.page-description') }) %>
<section class="card">
  <div class="card-header flex-wrap gap-3"><div><h2 class="card-title"><%= t('notifications.inbox') %></h2><p class="card-description"><%= t('notifications.count', { count: total, state: filter === 'unread' ? t('notifications.unread-state') : '' }) %></p></div><button class="btn btn-outline btn-sm" data-action="read-all-notifications" <%= total ? '' : 'disabled' %>><%- icon('check') %><%= t('notifications.all-read') %></button></div>
  <div class="record-tabs"><a href="/user/notifications" <%- filter === 'all' ? 'aria-current="page"' : '' %>><%= t('notifications.all') %></a><a href="/user/notifications?filter=unread" <%- filter === 'unread' ? 'aria-current="page"' : '' %>><%= t('notifications.unread') %></a></div>
  <% if (!rows.length) { %><div class="empty-state"><%- icon('mail','size-7') %><div class="empty-state-title"><%= t(filter === 'unread' ? 'notifications.no-unread' : 'notifications.none') %></div><p class="empty-state-text"><%= t('notifications.none-help') %></p></div><% } %>
  <% for (const item of rows) { %>
  <details class="inbox-item" data-notification-id="<%= item.id %>" data-unread="<%= item.read_at ? 'false' : 'true' %>"><summary><span class="inbox-dot" aria-hidden="true"></span><span class="inbox-subject"><strong><%= item.title %></strong><time><%= item.created_at %></time></span><span class="badge badge-outline" data-read-state><%= t(item.read_at ? 'notifications.read' : 'notifications.unread-label') %></span><%- icon('chevron-down') %></summary><div class="inbox-content prose"><%- item.html || t('notifications.empty-body') %></div></details>
  <% } %>
</section>
<%- include('../partials/layout-bottom') %>
