<%- include('../partials/layout-user-top', { title: '绑定角色', pageDescription: '使用启动器中的游戏名称绑定角色。' }) %>

<div class="max-w-lg">
  <% if (error) { %>
  <div class="alert alert-destructive mb-4" role="alert">
    <%- icon('alert-triangle') %>
    <div><%= error %></div>
  </div>
  <% } %>
  <div class="card">
    <div class="card-content">
      <form method="post" class="grid gap-4">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <label class="field">
          <span class="label">角色名</span>
          <input class="input" id="name" name="name" required maxlength="50" autocomplete="nickname">
        </label>
        <button class="btn btn-primary">绑定角色</button>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/layout-bottom') %>
