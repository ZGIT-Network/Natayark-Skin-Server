<%- include('../partials/layout-user-top', { title: t('bind-player.title'), pageDescription: t('bind-player.description') }) %>

<div class="max-w-lg">
  <% if (error) { %>
  <div class="alert alert-destructive mb-4" role="alert">
    <%- icon('alert-triangle') %>
    <div><%= error %></div>
  </div>
  <% } %>
  <div class="card">
    <div class="card-content">
      <form method="post" class="grid gap-4">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <label class="field">
          <span class="label"><%= t('bind-player.name') %></span>
          <input class="input" id="name" name="name" required maxlength="50" autocomplete="nickname">
        </label>
        <button class="btn btn-primary"><%= t('bind-player.submit') %></button>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/layout-bottom') %>
