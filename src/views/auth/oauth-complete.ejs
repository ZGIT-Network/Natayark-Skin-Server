<%- include('../partials/layout-auth-top', { authTitle: t('auth.complete-title'), authSubtitle: t('auth.complete-subtitle') }) %>

<% if (error) { %>
<div class="alert alert-destructive mb-4" role="alert">
  <%- icon('alert-triangle') %>
  <div><%= error %></div>
</div>
<% } %>
<% if (sent) { %>
<div class="alert alert-success mb-4" role="status">
  <%- icon('mail') %>
  <div><%= t('auth.verify-sent') %></div>
</div>
<% } %>

<form method="post" action="/auth/oauth/complete" class="grid gap-4">
  <input type="hidden" name="csrf" value="<%= csrf %>">
  <input type="hidden" name="flow" value="<%= flow %>">
  <label class="field">
    <span class="label"><%= t('auth.email') %></span>
    <input type="email" class="input" name="email" value="<%= email %>" required>
  </label>
  <% if (registerWithPlayerName) { %>
  <label class="field">
    <span class="label"><%= t('auth.username-player') %></span>
    <input type="text" class="input" name="player_name" value="<%= playerName %>" required autocomplete="username">
    <span class="field-hint"><%= t('auth.username-player-help') %></span>
  </label>
  <% } else { %>
  <label class="field">
    <span class="label"><%= t('auth.username-display') %></span>
    <input type="text" class="input" name="nickname" value="<%= nickname %>" required maxlength="50" autocomplete="nickname">
    <span class="field-hint"><%= t('auth.username-display-help') %></span>
  </label>
  <% } %>
  <label class="field">
    <span class="label"><%= t('auth.password') %></span>
    <input type="password" class="input" name="password" required minlength="8" autocomplete="new-password">
    <span class="field-hint"><%= t('auth.password-help') %></span>
  </label>
  <label class="field">
    <span class="label"><%= t('auth.confirm-password') %></span>
    <input type="password" class="input" name="password_confirm" required minlength="8" autocomplete="new-password">
  </label>
  <button type="submit" class="btn btn-primary btn-lg w-full"><%= t('auth.complete-registration') %></button>
</form>

<p class="mt-4 text-center text-sm text-muted-foreground">
  <a href="/auth/login" class="font-medium text-brand-strong hover:underline dark:text-brand"><%= t('general.back') %></a>
</p>

<%- include('../partials/layout-auth-bottom') %>
