<%- include('../partials/layout-auth-top', { authTitle: t('auth.forgot-title'), authSubtitle: t('auth.forgot-subtitle') }) %>

<% if (sent) { %>
<div class="alert alert-success" role="status">
  <%- icon('circle-check') %>
  <div><%= t('auth.reset-sent') %></div>
</div>
<% } else { %>
<% if (error) { %>
<div class="alert alert-destructive mb-4" role="alert">
  <%- icon('alert-triangle') %>
  <div><%= error %></div>
</div>
<% } %>
<form method="post" action="/auth/forgot" class="grid grid-cols-1 gap-4">
  <input type="hidden" name="csrf" value="<%= csrf %>">
  <label class="field">
    <span class="label"><%= t('auth.email') %></span>
    <input type="email" class="input" name="email" placeholder="you@example.com" required autofocus autocomplete="email">
  </label>
  <%- include('../partials/captcha') %>
  <button type="submit" class="btn btn-primary btn-lg w-full"><%= t('auth.send-reset') %></button>
</form>
<% } %>

<p class="mt-4 text-center text-sm text-muted-foreground">
  <a href="/auth/login" class="font-medium text-brand-strong hover:underline dark:text-brand"><%= t('general.login') %></a>
</p>

<%- include('../partials/layout-auth-bottom') %>
