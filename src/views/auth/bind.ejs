<%- include('../partials/layout-auth-top',{authTitle:t('auth.bind-title'),authSubtitle:t('auth.bind-subtitle')}) %>
<form action="/auth/bind" method="post" class="space-y-4"><input type="hidden" name="csrf" value="<%= csrf %>"><label class="field"><span class="label"><%= t('auth.email-address') %></span><input class="input" name="email" type="email" maxlength="100" required autocomplete="email" placeholder="you@example.com"><span class="field-hint"><%= t('auth.bind-help') %></span></label><button class="btn btn-primary w-full" type="submit"><%= t('common.send-verification') %></button></form>
<%- include('../partials/layout-auth-bottom') %>
