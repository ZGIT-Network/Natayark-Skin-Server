<%- include('../partials/layout-auth-top',{authTitle:t('auth.migrate-title'),authSubtitle:t('auth.migrate-subtitle')}) %>
<p class="mb-4 text-sm text-muted-foreground"><%= t('auth.migrate-provider', { provider: providerName }) %></p>
<% if(error) { %><p class="alert alert-destructive mb-4" role="alert"><%= error %></p><% } %>
<% if(sent) { %><p class="alert alert-success mb-4" role="status"><%= t('auth.migrate-sent', { email }) %></p><% } %>
<form method="post" action="/auth/oauth/migrate" class="space-y-3"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="flow" value="<%= flow %>"><input type="hidden" name="method" value="email"><p class="text-sm"><%= t('auth.verify-original-email') %>：<strong class="break-all"><%= email %></strong></p><button type="submit" class="btn btn-primary w-full" <%= mailAvailable&&!sent?'':'disabled' %>><%= t('auth.send-confirm') %></button><% if(!mailAvailable) { %><p class="field-hint"><%= t('auth.mail-unavailable') %></p><% } %></form>
<details class="mt-5 border-t border-border pt-4"><summary class="cursor-pointer text-sm text-muted-foreground"><%= t('auth.has-old-password') %></summary><form method="post" action="/auth/oauth/migrate" class="space-y-3 mt-4"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="flow" value="<%= flow %>"><input type="hidden" name="method" value="password"><label class="field"><span class="label"><%= t('auth.old-password') %></span><input class="input" type="password" name="password" autocomplete="current-password" required></label><button type="submit" class="btn btn-outline w-full"><%= t('auth.verify-and-login') %></button></form></details>
<%- include('../partials/layout-auth-bottom') %>
