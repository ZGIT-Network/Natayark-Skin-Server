<%- include('../partials/layout-auth-top',{authTitle:'确认原有账户',authSubtitle:'为原站账户连接稳定的第三方登录身份。'}) %>
<p class="mb-4 text-sm text-muted-foreground">已完成 <%= providerName %> 授权。原站未保存第三方用户标识，首次使用新版时需要确认一次账户归属。原有角色、UUID、材质和积分会保留。</p>
<% if(error) { %><p class="alert alert-destructive mb-4" role="alert"><%= error %></p><% } %>
<% if(sent) { %><p class="alert alert-success mb-4" role="status">验证邮件已发送至原账户邮箱 <%= email %>。请在当前浏览器中打开链接。</p><% } %>
<form method="post" action="/auth/oauth/migrate" class="space-y-3"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="flow" value="<%= flow %>"><input type="hidden" name="method" value="email"><p class="text-sm">验证原邮箱：<strong class="break-all"><%= email %></strong></p><button type="submit" class="btn btn-primary w-full" <%= mailAvailable&&!sent?'':'disabled' %>>发送确认邮件</button><% if(!mailAvailable) { %><p class="field-hint">站点尚未配置邮件服务；可以使用原密码验证，或联系管理员恢复邮件服务。</p><% } %></form>
<details class="mt-5 border-t border-border pt-4"><summary class="cursor-pointer text-sm text-muted-foreground">已设置过原账户密码？</summary><form method="post" action="/auth/oauth/migrate" class="space-y-3 mt-4"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="flow" value="<%= flow %>"><input type="hidden" name="method" value="password"><label class="field"><span class="label">原账户密码</span><input class="input" type="password" name="password" autocomplete="current-password" required></label><button type="submit" class="btn btn-outline w-full">验证并登录原账户</button></form></details>
<%- include('../partials/layout-auth-bottom') %>
