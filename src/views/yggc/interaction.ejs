<%- include('../partials/layout-standalone-top', { brand: 'Yggdrasil Connect' }) %>

<div class="mb-5">
  <h1 class="text-lg font-semibold tracking-tight"><%= t('device.request-title') %></h1>
  <p class="mt-1 text-sm text-muted-foreground"><%= t('device.request-help', { client: clientName, public: clientIsPublic ? t('device.public-client') : '' }) %></p>
</div>

<% if (error === 'NO_PROFILES') { %>
<div class="alert alert-destructive mb-4" role="alert">
  <%- icon('alert-triangle') %>
  <div><%= t('device.no-players') %><a href="/user/player"><%= t('device.create-player') %></a>。</div>
</div>
<form method="post" action="/connect/interaction/<%= uid %>/deny">
  <input type="hidden" name="csrf" value="<%= csrf %>">
  <button class="btn btn-destructive w-full" type="submit"><%= t('device.deny') %></button>
</form>
<% } else if (!loggedIn) { %>
<div class="alert alert-info mb-4">
  <%- icon('log-in') %>
  <div><%= t('device.login-first') %></div>
</div>
<a href="/auth/login?redirect=<%= encodeURIComponent('/connect/interaction/' + uid) %>" class="btn btn-primary btn-lg w-full"><%= t('general.login') %></a>
<% } else { %>
<%
  const scopeLabels = {
    'openid': t('device.scope-openid'),
    'profile': t('device.scope-profile'),
    'email': t('device.scope-email'),
    'offline_access': t('device.scope-offline'),
    'Yggdrasil.PlayerProfiles.Select': t('device.scope-select'),
    'Yggdrasil.PlayerProfiles.Read': t('device.scope-read'),
    'Yggdrasil.Server.Join': t('device.scope-join'),
  };
%>
<ul class="mb-5 divide-y divide-border rounded-lg border border-border">
  <% for (const s of scopes) { %>
  <li class="flex items-center gap-3 px-3 py-2.5 text-sm">
    <span class="text-brand"><%- icon('check', 'size-4') %></span>
    <span><%= scopeLabels[s] || s %></span>
  </li>
  <% } %>
</ul>

<form method="post" action="/connect/interaction/<%= uid %>/confirm" class="grid gap-4">
  <input type="hidden" name="csrf" value="<%= csrf %>">
  <% if (needsSelect) { %>
  <fieldset>
    <legend class="label mb-2"><%= t('device.choose-player') %></legend>
    <div class="grid gap-2">
      <% for (const p of profiles) { %>
      <label class="radio-row rounded-lg border border-border p-3 hover:bg-accent">
        <input type="radio" class="radio" id="profile-<%= p.id %>" name="selectedProfile" value="<%= p.id %>" required>
        <span class="flex-1">
          <span class="block text-sm font-medium"><%= p.name %></span>
          <span class="block font-mono text-xs text-muted-foreground"><%= maskUuid(p.id) %></span>
        </span>
      </label>
      <% } %>
    </div>
  </fieldset>
  <% } %>
  <button class="btn btn-primary btn-lg w-full" type="submit"><%= t('device.allow') %></button>
</form>
<form method="post" action="/connect/interaction/<%= uid %>/deny" class="mt-2">
  <input type="hidden" name="csrf" value="<%= csrf %>">
  <button class="btn btn-outline w-full" type="submit"><%= t('device.reject') %></button>
</form>
<% } %>

<%- include('../partials/layout-standalone-bottom') %>
