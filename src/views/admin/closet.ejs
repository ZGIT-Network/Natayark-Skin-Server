<%- include('../partials/layout-user-top',{title:t('admin.closet-title'),scope:'admin',pageDescription:(owner.nickname || owner.email) + ' · UID ' + owner.uid}) %>
<div class="closet-toolbar"><form class="library-search" method="get"><select class="select" name="type" aria-label="材质类型"><% for (const [key,label] of [['','全部类型'],['skin','皮肤'],['cape','披风'],['steve','Steve'],['alex','Alex']]) { %><option value="<%= key %>" <%= type === key ? 'selected' : '' %>><%= label %></option><% } %></select><input class="input" name="q" value="<%= keyword %>" placeholder="搜索衣柜名称" aria-label="搜索衣柜"><button class="btn btn-primary btn-icon" aria-label="搜索"><%- icon('search') %></button></form><a class="btn btn-ghost btn-sm" href="/admin/users">返回用户管理</a></div>
<form class="closet-add" data-action="admin-add-closet" data-owner="<%= owner.uid %>"><label class="field flex-1"><span class="label">添加材质</span><input class="input" name="tid" type="number" min="1" required placeholder="材质 TID" aria-label="材质 TID"></label><button class="btn btn-outline" type="submit"><%- icon('plus') %>添加到衣柜</button><span class="text-xs text-muted-foreground">按站点规则结算该用户的收藏积分。</span></form>
<p class="text-sm text-muted-foreground mb-4">共 <%= total %> 件材质</p>
<%- include('../partials/closet-grid',{manageUid:owner.uid}) %>
<%- include('../partials/pagination',{path:'/admin/closet/' + owner.uid,query:{q:keyword,type}}) %>
<%- include('../partials/layout-bottom') %>
