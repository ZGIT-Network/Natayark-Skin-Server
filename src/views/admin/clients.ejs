<%- include('../partials/layout-user-top', { title: t('admin.clients'), scope: 'admin', pageDescription: t('admin.clients-description') }) %>

<section class="card">
  <div class="card-header">
    <div><h2 class="card-title">现有客户端</h2><p class="card-description">共 <%= clients.length %> 个客户端</p></div>
  </div>
  <% if (clients.length === 0) { %>
  <div class="empty-state"><div class="empty-state-title">还没有注册的客户端</div></div>
  <% } else { %>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>ID</th><th>名称</th><th>类型</th><th>回调地址</th><th>密钥</th><th>状态</th><th class="text-right">操作</th></tr></thead>
      <tbody>
        <% for (const c of clients) { %>
        <tr>
          <td><code class="text-xs"><%= c.id %></code></td>
          <td class="font-medium"><%= c.name %></td>
          <td><span class="badge <%= c.secret ? 'badge-secondary' : 'badge-outline' %>"><%= c.secret ? '机密客户端' : '公共客户端' %></span></td>
          <td class="max-w-64"><code class="block truncate text-xs text-muted-foreground"><%= c.redirect || '—' %></code></td>
          <td>
            <% if (c.secret) { %>
            <details>
              <summary class="cursor-pointer text-xs font-medium text-brand-strong hover:underline dark:text-brand">显示</summary>
              <code class="mt-1 block max-w-48 truncate text-[0.7rem] text-muted-foreground"><%= c.secret %></code>
            </details>
            <% } else { %>—<% } %>
          </td>
          <td><span class="badge <%= c.revoked ? 'badge-destructive' : 'badge-success' %>"><%= c.revoked ? '已吊销' : '正常' %></span></td>
          <td class="text-right">
            <% if (!c.revoked) { %>
            <form method="post" action="/admin/clients" data-confirm="吊销该客户端？其所有令牌将失效。" data-confirm-danger>
              <input type="hidden" name="csrf" value="<%= csrf %>">
              <input type="hidden" name="action" value="delete">
              <input type="hidden" name="client_id" value="<%= c.id %>">
              <button class="btn btn-ghost btn-xs text-destructive hover:bg-destructive/10 hover:text-destructive" type="submit">吊销</button>
            </form>
            <% } %>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
</section>

<div class="mt-5 grid gap-5 lg:grid-cols-2">
  <section class="card">
    <div class="card-header"><div><h2 class="card-title">注册新客户端</h2></div></div>
    <div class="card-content">
      <form method="post" action="/admin/clients" class="grid gap-4">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <input type="hidden" name="action" value="create">
        <label class="field"><span class="label">应用名称</span><input class="input" name="name" required maxlength="100"></label>
        <label class="field">
          <span class="label">回调地址</span>
          <textarea class="textarea" name="redirect" rows="3" placeholder="https://app.example.com/callback"></textarea>
          <span class="field-hint">一行一个地址。</span>
        </label>
        <label class="checkbox-row">
          <input type="checkbox" class="checkbox" id="public-client" name="public_client" value="1">
          <span>公共客户端（无密钥，配合 PKCE / 设备码流）</span>
        </label>
        <button class="btn btn-primary" type="submit">注册</button>
      </form>
    </div>
  </section>

  <section class="card">
    <div class="card-header"><div><h2 class="card-title">公用应用</h2><p class="card-description">启动器使用此 Client ID 发起设备码授权。</p></div></div>
    <div class="card-content">
      <form method="post" action="/admin/clients" class="grid gap-4">
        <input type="hidden" name="csrf" value="<%= csrf %>">
        <input type="hidden" name="action" value="set_shared">
        <label class="field">
          <span class="label">Shared Client ID</span>
          <input class="input" name="shared_client_id" value="<%= sharedClientId %>" placeholder="客户端 ID，留空禁用">
        </label>
        <div class="flex justify-end"><button class="btn btn-outline" type="submit">保存</button></div>
      </form>
    </div>
  </section>
</div>

<%- include('../partials/layout-bottom') %>
