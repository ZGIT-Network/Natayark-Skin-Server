<%- include('../partials/layout-user-top', { title:t('admin.status'), scope:'admin', pageDescription:t('admin.status-description') }) %>
<%
  const size = bytes => { const units=['B','KiB','MiB','GiB','TiB']; let value=Number(bytes),unit=0; while(value>=1024&&unit<units.length-1){value/=1024;unit++;} return new Intl.NumberFormat(locale==='en'?'en-US':'zh-CN',{maximumFractionDigits:1}).format(value)+' '+units[unit]; };
  const date = value => new Intl.DateTimeFormat(locale==='en'?'en-GB':'zh-CN',{dateStyle:'short',timeStyle:'medium',timeZone:runtime.timezone}).format(new Date(value));
  const elapsed = t('status.duration',{days:Math.floor(runtime.uptime/86400),hours:Math.floor(runtime.uptime/3600)%24,minutes:Math.floor(runtime.uptime/60)%60,seconds:runtime.uptime%60});
  const groups=[
    ['status.environment',[
      ['status.application-version',runtime.version],['Node.js',runtime.node],['Fastify',runtime.fastify],['V8',runtime.v8],['status.os',runtime.platform],['status.cpu',runtime.cpuModel],['status.cores',runtime.cpuCores],['status.mode',runtime.mode],['status.timezone',runtime.timezone],
    ]],
    ['status.process',[
      ['PID',runtime.pid],['status.started',date(runtime.startedAt)],['status.uptime',elapsed],['status.rss',size(runtime.memory.rss)],['status.heap',size(runtime.memory.heapUsed)+' / '+size(runtime.memory.heapTotal)],['status.external',size(runtime.memory.external)],['status.host-memory',size(runtime.memory.hostFree)+' / '+size(runtime.memory.hostTotal)],['status.cpu-time',runtime.cpu.userSeconds+'s / '+runtime.cpu.systemSeconds+'s'],['status.event-loop',runtime.eventLoopPercent+'%'],
    ]],
    ['status.database',[
      ['status.db-version',runtime.database.version],['status.db-name',runtime.database.name],['status.db-latency',runtime.database.latency+' ms'],['status.db-charset',runtime.database.charset+' / '+runtime.database.collation],['status.db-tables',runtime.database.tables],['status.db-size',size(runtime.database.bytes)],['status.db-connections',runtime.database.maxConnections],['status.db-prefix',runtime.database.prefix||'—'],
    ]],
    ['status.storage',[
      ['status.texture-count',runtime.summary.textures],['status.texture-size',size(runtime.summary.storage*1024)],['status.disk-free',runtime.disk?size(runtime.disk.available)+' / '+size(runtime.disk.total):t('status.unavailable')],['status.texture-path',runtime.textureDir],['status.texture-access',t('status.'+runtime.textureState)],['status.users',runtime.summary.users],['status.players',runtime.summary.players],
    ]],
  ];
%>
<div class="status-snapshot"><p><%= t('status.sampled') %> <time datetime="<%= runtime.sampledAt %>"><%= date(runtime.sampledAt) %></time></p><a href="/admin/status" class="btn btn-outline btn-sm"><%- icon('refresh-cw') %><%= t('status.refresh') %></a></div>
<div class="grid gap-5 xl:grid-cols-2">
  <% for (const [heading,rows] of groups) { %>
  <section class="card" data-status-section="<%= heading %>"><div class="card-header"><h2 class="card-title"><%= t(heading) %></h2></div><dl class="rule-list status-list"><% for (const [label,value] of rows) { %><div><dt><%= t(label) %></dt><dd><% if(label==='status.application-version'){ %><code data-app-version><%= value %></code><% }else{ %><%= value %><% } %></dd></div><% } %></dl></section>
  <% } %>
  <section class="card xl:col-span-2"><div class="card-header"><h2 class="card-title"><%= t('status.services') %></h2></div><dl class="rule-list status-list"><div><dt><%= t('status.mail') %></dt><dd><%= t(mailConfigured?'status.configured':'status.not-configured') %></dd></div><div><dt><%= t('status.oauth-count') %></dt><dd><%= runtime.providerCount %></dd></div><div><dt><%= t('general.verification') %></dt><dd><%= t(runtime.microsoftConfigured?'status.configured':'status.not-configured') %></dd></div><div><dt>Yggdrasil Connect</dt><dd><a class="text-brand hover:underline" href="/.well-known/openid-configuration" target="_blank" rel="noopener"><%= t('status.discovery') %></a></dd></div></dl><p class="rule-note"><%= t('status.measurement-note') %></p></section>
</div>
<section class="card mt-5" data-update-check aria-labelledby="updates-title">
  <div class="card-header flex-wrap gap-4">
    <div>
      <h2 class="card-title" id="updates-title"><%= t('status.updates') %></h2>
      <p class="card-description" id="updates-description"><%= t('status.updates-unavailable') %></p>
    </div>
    <button type="button" class="btn btn-outline btn-sm" data-check-updates disabled aria-describedby="updates-description"><%- icon('refresh-cw') %><%= t('status.check-updates') %></button>
  </div>
</section>
<%- include('../partials/layout-bottom') %>
