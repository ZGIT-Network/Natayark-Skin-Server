<%- include('../partials/layout-user-top', { title: t('admin.ygg-log'), scope: 'admin', pageDescription: t('admin.ygg-log-description') }) %>

<section class="card">
  <div class="card-header"><div><h2 class="card-title">操作记录</h2><p class="card-description">共 <%= total %> 条记录</p></div></div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>时间</th><th>动作</th><th>用户</th><th>角色</th><th>IP</th><th>参数</th></tr></thead>
      <tbody>
        <% for (const log of logs) { %>
        <tr>
          <td class="whitespace-nowrap text-xs text-muted-foreground"><%= log.time %></td>
          <td><code class="text-xs"><%= log.action %></code></td>
          <td><%= log.user_id || '—' %></td>
          <td><%= log.player_id || '—' %></td>
          <td><code class="text-xs text-muted-foreground"><%= log.ip %></code></td>
          <td class="max-w-80 truncate" title="<%= log.parameters %>"><code class="text-xs text-muted-foreground"><%= log.parameters || '' %></code></td>
        </tr>
        <% } %>
        <% if (logs.length === 0) { %><tr><td colspan="6" class="table-empty">暂无记录</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <% if (pages > 1) { %>
  <div class="card-content pt-0">
    <nav class="pagination" aria-label="分页">
      <% for (let i = Math.max(1, page - 2); i <= Math.min(pages, page + 2); i++) { %>
      <a class="page-link <%= i === page ? 'active' : '' %>" href="/admin/ygg-log?page=<%= i %>"><%= i %></a>
      <% } %>
    </nav>
  </div>
  <% } %>
</section>

<%- include('../partials/layout-bottom') %>
