<%- include('../partials/layout-user-top', { title: t('general.user-manage'), scope: 'admin', pageDescription: '管理账户、积分与权限。' }) %>

<section class="card">
  <div class="card-header">
    <div><h2 class="card-title">用户</h2><p class="card-description">共 <%= total %> 位用户</p></div>
    <%- include('../partials/admin-search',{searchPath:'/admin/users',searchPlaceholder:t('search.users'),searchExample:'score>=100 verified sort:-score'}) %>
  </div>
  <% if (users.length === 0) { %>
  <div class="empty-state"><div class="empty-state-title">没有找到用户</div></div>
  <% } else { %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr><th>UID</th><th>邮箱</th><th>昵称</th><th>积分</th><th>权限</th><th>验证</th><th>注册时间</th><th class="text-right">操作</th></tr>
      </thead>
      <tbody>
        <% for (const u of users) { %>
        <tr data-admin-user="<%= u.uid %>">
          <td><code class="text-xs"><%= u.uid %></code></td>
          <td class="max-w-48 truncate"><%= u.email %></td>
          <td class="max-w-36 truncate"><%= u.nickname %></td>
          <td><%= u.score %></td>
          <td>
            <span class="select-wrap w-28">
              <select class="select h-8 text-xs" data-action="admin-set-user" data-uid="<%= u.uid %>" data-field="permission" aria-label="权限">
                <% for (const [val, label] of [[-1, '封禁'], [0, '普通'], [1, '管理员'], [2, '超管']]) { %>
                <option value="<%= val %>" <%= u.permission === val ? 'selected' : '' %>><%= label %></option>
                <% } %>
              </select>
            </span>
          </td>
          <td>
            <span class="select-wrap w-24">
              <select class="select h-8 text-xs" data-action="admin-set-user" data-uid="<%= u.uid %>" data-field="verified" aria-label="验证状态">
                <option value="1" <%= u.verified === 1 ? 'selected' : '' %>>已验证</option>
                <option value="0" <%= u.verified !== 1 ? 'selected' : '' %>>未验证</option>
              </select>
            </span>
          </td>
          <td class="whitespace-nowrap text-xs text-muted-foreground"><%= u.register_at %></td>
          <td class="text-right whitespace-nowrap">
            <a class="btn btn-ghost btn-xs" href="/admin/closet/<%= u.uid %>">衣柜</a>
            <button type="button" class="btn btn-outline btn-xs" data-action="admin-edit-user" data-uid="<%= u.uid %>" data-email="<%= u.email %>" data-nickname="<%= u.nickname %>" data-score="<%= u.score %>">编辑</button>
            <button type="button" class="btn btn-ghost btn-xs text-destructive hover:bg-destructive/10 hover:text-destructive" data-action="admin-delete-user" data-uid="<%= u.uid %>"><%- icon('trash-2') %></button>
          </td>
        </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <% } %>
  <% if (pages > 1) { %>
  <div class="card-content pt-0">
    <nav class="pagination" aria-label="分页">
      <% for (let i = Math.max(1, page - 2); i <= Math.min(pages, page + 2); i++) { %>
      <a class="page-link <%= i === page ? 'active' : '' %>" href="/admin/users?page=<%= i %><%= keyword ? '&keyword=' + encodeURIComponent(keyword) : '' %>"><%= i %></a>
      <% } %>
    </nav>
  </div>
  <% } %>
</section>

<dialog class="dialog" id="dialog-edit-user">
  <div class="dialog-header">
    <h2 class="dialog-title">编辑用户 <span id="edit-user-uid" class="font-normal text-muted-foreground"></span></h2>
    <button type="button" class="btn btn-ghost btn-icon btn-sm dialog-close" data-dialog-close aria-label="关闭"><%- icon('x') %></button>
  </div>
  <div class="dialog-body">
    <form data-action="admin-save-user" class="grid gap-4">
      <label class="field"><span class="label">邮箱</span><input class="input" name="email" type="email"></label>
      <label class="field"><span class="label">昵称</span><input class="input" name="nickname" maxlength="50"></label>
      <label class="field"><span class="label">积分</span><input class="input" name="score" type="number"></label>
      <label class="field"><span class="label">重置密码</span><input class="input" name="password" type="password" minlength="8" placeholder="留空则跳过"></label>
      <p class="hidden text-sm text-destructive" data-form-error></p>
    </form>
  </div>
  <div class="dialog-footer">
    <button type="button" class="btn btn-outline" data-dialog-close><%= t('common.cancel') %></button>
    <button type="button" class="btn btn-primary" data-submit-form="admin-save-user"><%= t('common.save') %></button>
  </div>
</dialog>

<%- include('../partials/layout-bottom') %>
