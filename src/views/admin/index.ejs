<%- include('../partials/layout-user-top', { title: t('general.admin-panel'), scope: 'admin', pageDescription: t('admin.index-description') }) %>

<div class="overview-stats">
  <a href="/admin/users" class="stat-card">
    <div><div class="stat-label">用户</div><div class="stat-value"><%= stats.users %></div></div>
  </a>
  <a href="/admin/players" class="stat-card">
    <div><div class="stat-label">角色</div><div class="stat-value"><%= stats.players %></div></div>
  </a>
  <a href="/admin/textures" class="stat-card">
    <div><div class="stat-label">材质</div><div class="stat-value"><%= stats.textures %></div></div>
  </a>
  <a href="/admin/reports" class="stat-card">
    <div><div class="stat-label">待处理举报</div><div class="stat-value"><%= stats.pending %></div></div>
  </a>
</div>

<section class="card mt-5"><div class="card-header"><div><h2 class="card-title">近 31 天</h2><p class="card-description">新增用户与材质上传 · 材质储存约 <%= (Number(stats.storage) / 1024).toFixed(1) %> MB</p></div><div class="chart-legend"><span>新增用户 <strong><%= chart.data[0].reduce((a,b) => a + b,0) %></strong></span><span>上传材质 <strong><%= chart.data[1].reduce((a,b) => a + b,0) %></strong></span></div></div>
  <% const chartMax = Math.max(1,...chart.data.flat()); %><div class="activity-chart" role="img" aria-label="近 31 天每日新增用户和上传材质，明细可在下方展开查看"><% for (let index = 0; index < chart.xAxis.length; index++) { %><div class="chart-group" title="<%= chart.xAxis[index] %>：新增用户 <%= chart.data[0][index] %>，上传材质 <%= chart.data[1][index] %>"><span style="height:<%= chart.data[0][index] / chartMax * 100 %>%"></span><span style="height:<%= chart.data[1][index] / chartMax * 100 %>%"></span></div><% } %></div><div class="chart-axis"><span><%= chart.xAxis[0] %></span><span><%= chart.xAxis.at(-1) %></span></div>
  <details class="chart-details"><summary>查看每日明细</summary><div class="table-wrap"><table class="table"><thead><tr><th>日期</th><th>新增用户</th><th>上传材质</th></tr></thead><tbody><% for (let index = 30; index >= 0; index--) { %><tr><td><%= chart.xAxis[index] %></td><td><%= chart.data[0][index] %></td><td><%= chart.data[1][index] %></td></tr><% } %></tbody></table></div></details>
</section>

<div class="mt-5 grid gap-5 lg:grid-cols-3">
  <section class="card lg:col-span-2">
    <div class="card-header">
      <div><h2 class="card-title">最近的 Yggdrasil 活动</h2></div>
      <a href="/admin/ygg-log" class="btn btn-ghost btn-sm">查看全部<%- icon('arrow-right', 'size-3') %></a>
    </div>
    <% if (lastLog.length === 0) { %>
    <div class="empty-state"><div class="empty-state-title">暂无记录</div></div>
    <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>时间</th><th>动作</th><th>用户</th><th>IP</th></tr></thead>
        <tbody>
          <% for (const log of lastLog) { %>
          <tr>
            <td class="whitespace-nowrap text-muted-foreground"><%= log.time %></td>
            <td><code class="text-xs"><%= log.action %></code></td>
            <td><%= log.user_id || '—' %></td>
            <td><code class="text-xs text-muted-foreground"><%= log.ip %></code></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% } %>
  </section>

  <section class="card">
    <div class="card-header"><div><h2 class="card-title">快捷入口</h2></div></div>
    <div class="card-content grid gap-2">
      <a href="/admin/settings" class="btn btn-outline justify-start">站点设置</a>
      <a href="/admin/notifications" class="btn btn-outline justify-start">发送站内通知</a>
      <a href="/admin/status" class="btn btn-outline justify-start">系统状态</a>
      <a href="/admin/clients" class="btn btn-outline justify-start">OAuth / OIDC 客户端</a>
      <a href="/admin/translations" class="btn btn-outline justify-start">语言覆盖</a>
      <a href="/admin/ygg-log" class="btn btn-outline justify-start">Yggdrasil 日志</a>
    </div>
  </section>
</div>

<%- include('../partials/layout-bottom') %>
