<% if (!closet.length) { %><section class="card"><div class="empty-state"><%- icon('shirt','size-7') %><div class="empty-state-title"><%= keyword || type ? '没有找到材质' : '衣柜还是空的' %></div><p class="empty-state-text">可以调整筛选，或从皮肤库添加材质。</p><a class="btn btn-outline btn-sm" href="/skinlib">浏览皮肤库</a></div></section><% } else { %>
<div class="library-grid"><% for (const item of closet) { %><article class="library-card" data-closet-item="<%= item.tid %>">
  <a class="library-preview" href="/skinlib/show/<%= item.tid %>" data-image-state="loading"><span class="image-skeleton" aria-hidden="true"></span><img src="/preview/<%= item.tid %>?v=4&model=<%= item.type %>" alt="<%= item.item_name %>" loading="lazy" width="430" height="437"></a>
  <div class="library-caption"><a class="library-name" href="/skinlib/show/<%= item.tid %>" title="<%= item.item_name %>"><%= item.item_name %></a><div class="flex items-center justify-between gap-2 mt-2"><span class="library-model"><%= item.type === 'cape' ? '披风' : item.type === 'alex' ? 'Alex' : 'Steve' %></span><span class="text-xs text-muted-foreground">#<%= item.tid %> · <%= item.public ? '公开' : '私有' %></span></div><div class="flex gap-2 mt-3">
  <% if (!manageUid) { %><button class="btn btn-outline btn-xs flex-1" data-action="rename-closet" data-tid="<%= item.tid %>" data-name="<%= item.item_name %>"><%- icon('pencil') %>改名</button><% } %>
  <button class="btn btn-outline btn-xs" data-action="remove-closet" data-tid="<%= item.tid %>" <%- manageUid ? 'data-owner="' + manageUid + '"' : '' %>><%- icon('trash-2') %>移除</button></div></div>
</article><% } %></div><% } %>
