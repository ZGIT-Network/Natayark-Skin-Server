<% if (!closet.length) { %><section class="card"><div class="empty-state"><%- icon('shirt','size-7') %><div class="empty-state-title"><%= t(keyword || type ? 'closet.no-match-title' : 'closet.empty-title') %></div><p class="empty-state-text"><%= t('closet.empty-help') %></p><a class="btn btn-outline btn-sm" href="/skinlib"><%= t('closet.browse') %></a></div></section><% } else { %>
<div class="library-grid"><% for (const item of closet) { %><article class="library-card" data-closet-item="<%= item.tid %>">
  <a class="library-preview" href="/skinlib/show/<%= item.tid %>" data-image-state="loading"><span class="image-skeleton" aria-hidden="true"></span><img src="/preview/<%= item.tid %>?v=4&model=<%= item.type %>" alt="<%= item.item_name %>" loading="lazy" width="430" height="437"></a>
  <div class="library-caption"><a class="library-name" href="/skinlib/show/<%= item.tid %>" title="<%= item.item_name %>"><%= item.item_name %></a><div class="flex items-center justify-between gap-2 mt-2"><span class="library-model"><%= item.type === 'cape' ? t('skinlib.type-cape') : item.type === 'alex' ? 'Alex' : 'Steve' %></span><span class="text-xs text-muted-foreground">#<%= item.tid %> · <%= t(item.public ? 'common.public' : 'common.private') %></span></div><div class="closet-item-actions">
  <% if (!manageUid) { %><button class="btn btn-outline btn-xs flex-1" data-action="rename-closet" data-tid="<%= item.tid %>" data-name="<%= item.item_name %>"><%- icon('pencil') %><%= t('skinlib.closet-rename') %></button><% } %>
  <button class="btn btn-outline btn-xs" data-action="remove-closet" data-tid="<%= item.tid %>" <%- manageUid ? 'data-owner="' + manageUid + '"' : '' %>><%- icon('trash-2') %><%= t('skinlib.closet-remove') %></button></div></div>
</article><% } %></div><% } %>
