  const __lang = typeof htmlLang !== 'undefined' ? htmlLang : 'zh-CN';
  const __dark = typeof darkMode !== 'undefined' && darkMode;
  const __brand = typeof brand !== 'undefined' && brand ? brand : (typeof siteName !== 'undefined' ? siteName : 'Natayark SkinServer');
%>
<!DOCTYPE html>
<html lang="<%= __lang %>" class="<%= __dark ? 'dark' : '' %>">
<head>
  <%- include('head') %>
</head>
