<%
  if (typeof t !== 'function') locals.t = function (key) { return key; };
  const __path = typeof currentPath !== 'undefined' ? currentPath : '/';
  const __locale = typeof locale !== 'undefined' ? locale : 'zh_CN';
%>
<div class="dropdown h-8" data-dropdown data-locale-menu>
  <button type="button" class="btn btn-ghost btn-sm" data-dropdown-trigger aria-label="<%= t('locale.choose') %>" aria-haspopup="menu" aria-expanded="false">
    <%- icon('globe') %>
    <span class="language-label hidden sm:inline"><%= __locale === 'en' ? 'English' : '简体中文' %></span>
    <%- icon('chevron-down', 'size-3 opacity-60') %>
  </button>
  <div class="dropdown-menu" data-dropdown-menu role="menu" hidden>
    <form method="post" action="/locale" data-locale-form>
    <input type="hidden" name="csrf" value="<%= typeof csrf !== 'undefined' ? csrf : '' %>">
    <input type="hidden" name="redirect" value="<%= typeof localeReturnTo !== 'undefined' ? localeReturnTo : __path %>">
    <button type="submit" name="locale" value="zh_CN" class="dropdown-item w-full" data-dropdown-item role="menuitemradio" aria-checked="<%= __locale !== 'en' %>">
      <span class="flex-1">简体中文</span>
      <% if (__locale !== 'en') { %><%- icon('check', 'size-4 dropdown-check') %><% } %>
    </button>
    <button type="submit" name="locale" value="en" class="dropdown-item w-full" data-dropdown-item role="menuitemradio" aria-checked="<%= __locale === 'en' %>">
      <span class="flex-1">English</span>
      <% if (__locale === 'en') { %><%- icon('check', 'size-4 dropdown-check') %><% } %>
    </button>
    </form>
  </div>
</div>
