<%
  const linkTo = (p, changes = {}) => {
    const q = new URLSearchParams();
    for (const [key, value] of Object.entries({...filters, ...changes})) if (value) q.set(key, value);
    if (p > 1) q.set('page', p);
    return libraryBase + (q.size ? '?' + q.toString() : '');
  };
%>
<div class="library-heading">
  <p><%= total %> 件材质<% if (filters.uploader) { %> · 上传者 UID <%= filters.uploader %> <a href="<%= linkTo(1, {uploader:''}) %>">取消筛选</a><% } %></p>
  <a href="/skinlib/upload" class="btn btn-primary"><%- icon('upload') %><%= t('skinlib.upload') %></a>
</div>

<section class="library-panel">
  <div class="library-toolbar">
    <form method="get" action="<%= libraryBase %>" class="library-search">
      <input type="hidden" name="sort" value="<%= filters.sort %>">
      <% if (filters.uploader) { %><input type="hidden" name="uploader" value="<%= filters.uploader %>"><% } %>
      <label class="sr-only" for="library-type">材质类型</label>
      <select class="select" id="library-type" name="type" aria-label="材质类型">
        <% for (const [key,label] of [['','全部'],['skin','皮肤'],['steve','Steve'],['alex','Alex'],['cape','披风']]) { %>
        <option value="<%= key %>" <%= filters.type === key ? 'selected' : '' %>><%= label %></option>
        <% } %>
      </select>
      <input class="input" name="keyword" value="<%= filters.keyword %>" placeholder="搜索" aria-label="搜索材质">
      <button type="submit" class="btn btn-primary btn-icon" aria-label="搜索"><%- icon('search') %></button>
      <% if (user) { %>
      <select class="select library-visibility" name="status" aria-label="可见性">
        <% for (const [key,label] of [['','全部可见'],['public','公开'],['private','私有']]) { %><option value="<%= key %>" <%= filters.status === key ? 'selected' : '' %>><%= label %></option><% } %>
      </select>
      <% } %>
    </form>
    <nav class="library-sort" aria-label="材质排序">
      <a href="<%= linkTo(1, {sort:'likes'}) %>" class="<%= filters.sort === 'likes' ? 'active' : '' %>" <%- filters.sort === 'likes' ? 'aria-current="true"' : '' %>>最多收藏</a>
      <a href="<%= linkTo(1, {sort:'time'}) %>" class="<%= filters.sort === 'time' ? 'active' : '' %>" <%- filters.sort === 'time' ? 'aria-current="true"' : '' %>>最新上传</a>
      <a href="<%= libraryBase %>">清除筛选</a>
    </nav>
  </div>

  <% if (!items.length) { %>
  <div class="empty-state"><div class="empty-state-title">没有符合条件的材质</div><div class="empty-state-text">调整搜索或筛选条件后重试。</div></div>
  <% } else { %>
  <div class="library-grid">
    <% for (const [index,item] of items.entries()) { %>
    <article class="library-card" data-texture-id="<%= item.tid %>">
      <a href="/skinlib/show/<%= item.tid %>" class="library-preview" aria-label="预览 <%= item.name %>" data-image-state="loading" aria-busy="true">
        <span class="image-skeleton" aria-hidden="true"></span>
        <img src="/preview/<%= item.tid %>?v=4&model=<%= item.type %>&height=320" alt="<%= item.name %> 的正面与背面预览" <%- index < 4 ? 'fetchpriority="high"' : 'loading="lazy"' %> decoding="async">
        <% if (!item.public) { %><span class="library-private">私有</span><% } %>
      </a>
      <div class="library-caption">
        <a href="/skinlib/show/<%= item.tid %>" class="library-name" title="<%= item.name %>"><%= item.name %></a>
        <div class="library-meta">
          <span class="library-model"><%= item.type === 'cape' ? '披风' : item.type === 'alex' ? 'Alex' : 'Steve' %></span>
          <a class="library-uploader" href="<%= linkTo(1, {uploader:String(item.uploader)}) %>" title="查看此用户上传的材质"><%= item.nickname || ('UID ' + item.uploader) %></a>
          <span class="library-likes" aria-label="<%= item.likes %> 次收藏"><%- icon('heart') %><%= item.likes %></span>
        </div>
        <% if (adminMode) { %>
        <div class="library-admin-actions"><code>#<%= item.tid %></code><a href="/skinlib/show/<%= item.tid %>" class="btn btn-ghost btn-xs"><%- icon('pencil') %>编辑</a><button type="button" class="btn btn-ghost btn-icon btn-xs text-destructive" data-action="admin-delete-texture" data-tid="<%= item.tid %>" aria-label="删除 <%= item.name %>"><%- icon('trash-2') %></button></div>
        <% } %>
      </div>
    </article>
    <% } %>
  </div>
  <% } %>
</section>
<% if (pages > 1) { %>
<nav class="pagination mt-6 justify-center" aria-label="分页">
  <% if (page > 1) { %><a class="page-link" href="<%= linkTo(page-1) %>" aria-label="上一页"><%- icon('chevron-left') %></a><% } %>
  <% for (let number=Math.max(1,page-2);number<=Math.min(pages,page+2);number++) { %><a class="page-link <%= number === page ? 'active' : '' %>" href="<%= linkTo(number) %>" <%- number === page ? 'aria-current="page"' : '' %>><%= number %></a><% } %>
  <% if (page < pages) { %><a class="page-link" href="<%= linkTo(page+1) %>" aria-label="下一页"><%- icon('chevron-right') %></a><% } %>
</nav>
<% } %>
