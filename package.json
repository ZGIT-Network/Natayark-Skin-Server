{
  "name": "natayark-skin-server",
  "version": "1.0.0",
  "description": "Self-hosted Minecraft skin server with Yggdrasil authentication and Yggdrasil Connect.",
  "private": true,
  "license": "MIT",
  "files": ["dist/","src/","scripts/","migrations/","public/","tests/","docs/","schema.sql","tsconfig.json",".env.example","LICENSE","THIRD_PARTY_NOTICES.md","CONTRIBUTING.md","SECURITY.md"],
  "repository": {
    "type": "git",
    "url": "https://github.com/ZGIT-Network/Natayark-Skin-Server.git"
  },
  "bugs": {
    "url": "https://github.com/ZGIT-Network/Natayark-Skin-Server/issues"
  },
  "homepage": "https://github.com/ZGIT-Network/Natayark-Skin-Server#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/configure.mjs",
    "repo:check": "node scripts/check-repository.mjs",
    "db:init": "tsx scripts/initialize.ts",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p . && node scripts/build-client.mjs && npm run css",
    "start": "node dist/index.js",
    "client": "node scripts/build-client.mjs",
    "css": "tailwindcss -i ./src/styles/app.css -o ./public/css/app.css --minify",
    "typecheck": "tsc -p . --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "test": "node --import tsx --test tests/auth.test.ts tests/economy.test.ts tests/theme.test.ts tests/render.test.ts tests/client-feedback.test.ts tests/search.test.ts",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fastify/view": "^12.0.1",
    "@node-rs/argon2": "^2.2.2",
    "@sicons/ionicons5": "^0.13.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.9",
    "ejs": "^3.1.10",
    "fastify": "^5.2.2",
    "jose": "^5.9.6",
    "marked": "^15.0.7",
    "mysql2": "^3.14.0",
    "nodemailer": "^6.10.1",
    "pngjs": "^7.0.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/ejs": "^3.1.5",
    "@types/marked": "^6.0.0",
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pngjs": "^6.0.5",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.25.3",
    "openid-client": "^6.8.8",
    "skinview3d": "^3.4.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
